# =============================================================
# ResolveIQ — Environment Variable Template
# =============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to Git.
# NEVER prefix these with NEXT_PUBLIC_ — they must stay server-side only.
# =============================================================

# --- Gemini AI ---
# Your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# The Gemini model to use for the AI agent.
# Current default: gemini-3.8-flash (stable, fast, supports tool calling)
# Change this here to switch models without touching agent code.
GEMINI_MODEL=gemini-3.8-flash

# --- MongoDB Atlas ---
# Your MongoDB connection string from Atlas dashboard.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=
