# Normalize line endings to LF on commit, convert to CRLF on Windows checkout.
# This prevents "entire file changed" diffs when switching between Windows and Linux/Mac.
* text=auto eol=lf

# Force these to always be LF (never CRLF)
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.env* text eol=lf

# Binaries — do not modify
*.ico  binary
*.png  binary
*.jpg  binary
*.svg  text eol=lf
